      "parameters": {
        "promptType": "define",
        "text": "=You are writing a short, casual email on behalf of Montrega, a D2C fragrance brand based in India. The message is to a potential nano-influencer or micro-influencer we want to collaborate with.\n\nHere is what we know about them:\n- Instagram handle: {{ $json.fields.Username }}\n- Full name: {{ $json.fields[\"Full name\"] }}\n- Bio: {{ $json.fields.Bio }}\n- Followers: {{ $json.fields.Followers }}\n\nRules:\n1. Keep it under 60 words.\n2. Reference something specific from their bio or content style — never send a generic \"love your content\" message.\n3. Mention Montrega by name. Say we're a skin-adaptive fragrance brand.\n4. The ask: would they be open to trying the product and sharing honest thoughts? No payment offer. No pressure.\n5. Tone: casual, direct, human. Not corporate. Not desperate. Like a founder DM, not a brand pitch.\n6. Do NOT use emojis excessively. Max 1 emoji, or zero.\n7. Sign off as \"Bruno, Montrega\".\n\nOutput ONLY the DM text. No explanations, no preamble, no quotes around it.",
        "batching": {}
      },
