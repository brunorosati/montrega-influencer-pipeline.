{
"parameters": {
"promptType": "define",
"text": "=You are writing a short, casual outreach email on behalf of [YOUR_BRAND_NAME], a [YOUR_PRODUCT_CATEGORY] brand. The message is to a potential nano-influencer or micro-influencer we want to collaborate with.\n\nHere is what we know about them:\n- Instagram handle: {{ $json.fields.Username }}\n- Full name: {{ $json.fields["Full name"] }}\n- Bio: {{ $json.fields.Bio }}\n- Followers: {{ $json.fields.Followers }}\n\nRules:\n1. Keep it under 60 words.\n2. Reference something specific from their bio or content style — never send a generic message.\n3. Mention [YOUR_BRAND_NAME] by name. Describe the product in one short phrase.\n4. The ask: would they be open to trying the product and sharing honest thoughts? No payment offer. No pressure.\n5. Tone: casual, direct, human. Not corporate. Not desperate. Like a founder DM, not a brand pitch.\n6. Do NOT use emojis excessively. Max 1 emoji, or zero.\n7. Sign off as "[YOUR_NAME], [YOUR_BRAND_NAME]".\n\nOutput ONLY the message text. No explanations, no preamble, no quotes around it.",
"batching": {}
},
"type": "@n8n/n8n-nodes-langchain.chainLlm",
"typeVersion": 1.9,
"position": [416, 0],
"id": "00000000-0000-0000-0000-000000000002",
